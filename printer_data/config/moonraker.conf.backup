[server]
host: 0.0.0.0
port: 7125
klippy_uds_address: /home/biqu/printer_data/comms/klippy.sock

[file_manager]
config_path: /home/biqu/printer_data/config
log_path: /home/biqu/printer_data/logs

[authorization]
trusted_clients:
    127.0.0.1
    192.168.0.0/16
cors_domains:
    *.local
    *.lan
    *://localhost
    *://localhost:*
    *://192.168.1.69
    *://192.168.1.69:*

[octoprint_compat]

[history]

[update_manager]
channel: dev
refresh_interval: 168



[include octoeverywhere-system.cfg]
